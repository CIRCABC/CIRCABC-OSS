<?xml version='1.0' encoding='UTF-8' ?>
<beans
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
>

    <!-- The bootstrap-context.xml file is used for patch definitions, importers, 
		 workflow, and loading custom content models.  -->

    <!-- Registration of new models -->
    
    <!-- prettier-ignore-start -->
    <bean
    id="circabc-rest-platform.dictionaryBootstrap"
    parent="dictionaryModelBootstrap"
    depends-on="dictionaryBootstrap"
  >
        <property name="models">
            <list>
                <value
        >alfresco/module/${project.artifactId}/model/content-model.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/workflow-model.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/DocumentModel.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/DossierModel.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/DynamicPropertiesModel.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/EventModel.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/KeywordModel.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/ModerationModel.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/ShareSpaceModel.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/SurveyModel.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/SystemMessageModel.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/UserModel.xml</value>
                <value
        >alfresco/module/${project.artifactId}/model/CircabcModel.xml</value>
            </list>
        </property>
        <property name="labels">
            <list>
                <!-- Bootstrap Resource Bundles for the content model types, aspects, properties etc -->
                <value
        >alfresco/module/${project.artifactId}/messages/content-model</value>
            </list>
        </property>
    </bean>

    <bean
    id="eu.europa.ec.digit.circabc.rest.sampleprocess.workflowBootstrap"
    parent="workflowDeployer"
  >
        <property name="workflowDefinitions">
            <list>
                <props>
                    <prop key="engineId">activiti</prop>
                    <prop key="location">
                        alfresco/module/${project.artifactId}/workflow/sample-process.bpmn20.xml</prop>
                    <prop key="mimetype">text/xml</prop>
                </props>
            </list>
        </property>
        <property name="labels">
            <list>
                <value
        >alfresco/module/${project.artifactId}/messages/workflow-messages</value>
            </list>
        </property>
    </bean>
    <bean id="circabc-permissionDefinitions" parent="permissionModelBootstrap">
        <property
      name="model"
      value="alfresco/module/${project.artifactId}/model/circabc-permissionDefinitions.xml"
    />
    </bean>
    <!-- prettier-ignore-end -->

</beans>
