<beans
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
>
    <bean
        id="formatMessageTemplateExtension"
        parent="baseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.I18NFormatMessageMethod"
    >
        <property name="extensionName">
            <value>formatMessage</value>
        </property>
    </bean>

    <bean
        id="fullUserNameTemplateExtension"
        parent="baseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.UserDisplayNameMethod"
    >
        <property name="extensionName">
            <value>fullName</value>
        </property>
        <property name="serviceRegistry">
            <ref bean="ServiceRegistry" />
        </property>
    </bean>

    <bean
        id="loginUserNameTemplateExtension"
        parent="baseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.LoginUserNameMethod"
    >
        <property name="extensionName">
            <value>loginUserName</value>
        </property>
        <property name="serviceRegistry">
            <ref bean="ServiceRegistry" />
        </property>
    </bean>

    <bean
        id="ConcatAsStringTemplateExtension"
        parent="baseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.ConcatAsStringMethod"
    >
        <property name="extensionName">
            <value>concatStr</value>
        </property>
    </bean>

    <bean
        id="nodeRefBaseTemplateImplementation"
        parent="baseTemplateImplementation"
        abstract="true"
    >
        <property name="nodeService">
            <ref bean="nodeService" />
        </property>
    </bean>

    <bean
        id="directAccessUrlTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.DirectAccessUrlMethod"
    >
        <property name="extensionName">
            <value>accessUrl</value>
        </property>
    </bean>

    <bean
        id="simpleDirectAccessUrlTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.SimpleDirectAccessUrlMethod"
    >
        <property name="extensionName">
            <value>simpleAccessUrl</value>
        </property>
    </bean>

    <bean
        id="directDownloadUrlTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.DirectDowloadUrlMethod"
    >
        <property name="extensionName">
            <value>downloadUrl</value>
        </property>
    </bean>

    <bean
        id="simpleDirectDownloadUrlTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.SimpleDirectDowloadUrlMethod"
    >
        <property name="extensionName">
            <value>simpleDownloadUrl</value>
        </property>
    </bean>

    <bean
        id="NodePathTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.NodePathMethod"
    >
        <property name="extensionName">
            <value>circabcPath</value>
        </property>
    </bean>

    <bean
        id="LibraryNodePathTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.LibraryNodePathMethod"
    >
        <property name="extensionName">
            <value>libraryPath</value>
        </property>
    </bean>

    <bean
        id="TitleOrNameMethod"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.TitleOrNameMethod"
    >
        <property name="extensionName">
            <value>titleOrName</value>
        </property>
    </bean>

    <bean
        id="DynamicPropertyDescriptionMethod"
        parent="baseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.DynamicPropertyDescriptionMethod"
    >
        <property name="extensionName">
            <value>dynamicPropertyDescriptions</value>
        </property>
    </bean>

    <bean
        id="UserNameOrEcasUserName"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.UserNameOrEcasUserNameMethod"
    >
        <property name="extensionName">
            <value>userNameOrEcasUserName</value>
        </property>
    </bean>

    <bean
        id="MailAddress"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.MailAddress"
    >
        <property name="extensionName">
            <value>mailAddress</value>
        </property>
    </bean>

    <!-- Extensions made for the new UI links -->

    <bean
        id="libraryNodeLinkTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.LibraryNodeLinkMethod"
    >
        <property name="extensionName">
            <value>libraryAccessUrl</value>
        </property>
    </bean>

    <bean
        id="groupNodeLinkTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.GroupNodeLinkMethod"
    >
        <property name="extensionName">
            <value>groupAccessUrl</value>
        </property>
    </bean>

    <bean
        id="agendaNodeLinkTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.AgendaNodeLinkMethod"
    >
        <property name="extensionName">
            <value>agendaAccessUrl</value>
        </property>
    </bean>

    <bean
        id="forumNodeLinkTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.ForumNodeLinkMethod"
    >
        <property name="extensionName">
            <value>forumAccessUrl</value>
        </property>
    </bean>

    <bean
        id="categoryGroupRequestAccessUrlTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.CategoryGroupRequesLinkMethod"
    >
        <property name="extensionName">
            <value>categoryGroupRequestAccessUrl</value>
        </property>
    </bean>

    <bean
        id="getMLDisplayTitleTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.MLDisplayTitleMethod"
    >
        <property name="extensionName">
            <value>getMLDisplayTitle</value>
        </property>
    </bean>

    <bean
        id="getMLDisplayDescriptionTemplateExtension"
        parent="nodeRefBaseTemplateImplementation"
        class="eu.europa.ec.digit.circabc.rest.template.MLDisplayDescriptionMethod"
    >
        <property name="extensionName">
            <value>getMLDisplayDescription</value>
        </property>
    </bean>
</beans>
