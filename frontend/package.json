{
  "name": "circabc",
  "version": "5.0.0.0",
  "license": "EUPL-1.1",
  "angular-cli": {},
  "scripts": {
    "ng": "ng",
    "postinstall": "node getBuildDate.js --if-missing",
    "pretsc": "node getBuildDate.js --if-missing",
    "prelint": "node getBuildDate.js --if-missing",
    "pretest": "node getBuildDate.js --if-missing",
    "prebuild": "node getBuildDate.js",
    "prestart": "node getBuildDate.js",
    "ng-copilot": "ng g ai-config --tool copilot",
    "ng-claude": "ng g ai-config --tool claude",
    "ng-jetbrains": "ng g ai-config --tool jetbrains",
    "nx-migrate": "nx migrate latest",
    "ng-version": "ng version",
    "ng-update": "ng update @angular/core @angular/cli --next --force  --allow-dirty",
    "ng-update-help": "ng update --help",
    "start": "ng serve -o",
    "build": "ng build",
    "dcp": "npx jscpd  src --format \"typescript,markup,scss\"  --ignore \"src/app/core/generated/**/*.ts\" --min-lines 30 --max-lines 2000 ",
    "format-check": "prettier --single-quote --list-different --html-whitespace-sensitivity strict \"src/**/*.html\" \"src/**/*.ts\" ",
    "format-fix": "prettier --write --single-quote --list-different --html-whitespace-sensitivity strict \"src/**/*.html\" \"src/**/*.ts\" ",
    "format-changed": "git diff --name-only --diff-filter=AM HEAD | grep -E \"\\.(html|ts)$\" | sed 's|^circabc-frontend/||' | xargs -r prettier --write --single-quote --html-whitespace-sensitivity strict",
    "format-fix-gen": "prettier --write --single-quote --list-different \"src/app/core/generated/**/*.ts\" ",
    "format-check-scss": "prettier --single-quote --list-different  \"src/**/*.scss\" ",
    "format-fix-scss": "prettier --write --single-quote --list-different  \"src/**/*.scss\" ",
    "lockfile-lint": "npx lockfile-lint --path package-lock.json --type npm --allowed-hosts npm yarn --validate-https",
    "tsc": "tsc  --project src/tsconfig.app.json --pretty",
    "tsc-go": "node node_modules/@typescript/native-preview/bin/tsgo --project src/tsconfig.tsgo.json --pretty",
    "topce-tsc-go": "node node_modules/@topce/native-preview/bin/tsgo --project src/tsconfig.topce.json --pretty",
    "tsc-watch": "tsc  --project src/tsconfig.app.json --pretty --watch",
    "tsc-heap": "node --max-old-space-size=8192 ./node_modules/typescript/lib/tsc.js  --project src/tsconfig.app.json --pretty",
    "stylelint": "node ./node_modules/stylelint/bin/stylelint.mjs \"src/**/*.scss\" --custom-syntax postcss-scss ",
    "stylelint-html": "node ./node_modules/stylelint/bin/stylelint.mjs \"src/**/*.html\" ",
    "stylelint-fix": "node ./node_modules/stylelint/bin/stylelint.mjs \"src/**/*.scss\" --custom-syntax postcss-scss --fix",
    "stylelint-html-fix": "node ./node_modules/stylelint/bin/stylelint.mjs \"src/**/*.html\" --fix ",
    "lint": "ng lint circabc --format stylish",
    "lint-force": "ng lint circabc --force  --format stylish",
    "lint-fix": "ng lint circabc --fix --force  --format stylish",
    "lint-biome": "biome check ./src",
    "lint-fix-biome": "biome check ./src --write --unsafe",
    "build-stats": "ng build --stats-json",
    "view-stats": "npx webpack-bundle-analyzer dist/circabc/stats.json",
    "doc-build": "npx @compodoc/compodoc -p tsconfig.json",
    "doc-build-heap": "npm run doc-build  --max-old-space-size=8192",
    "doc-serve": "npx http-server ./documentation -p 9090",
    "doc-build-serve": "npx @compodoc/compodoc -p tsconfig.json -s -r 9090 -o",
    "get-build-date": "node getBuildDate.js",
    "http-serve": "npx http-server ./dist/circabc -p 4200",
    "bamboo": "npm run get-build-date && npm run tsc && npm run format-check && npm run lint  && npm run stylelint && npm run build ",
    "bamboo-biome": "npm run get-build-date && npm run tsc && npm run format-check && npm run lint && npm run lint-biome && npm run stylelint && npm run build ",
    "build-training": "npm run get-build-date && ng build -c=training",
    "localhost-serve": "npm run get-build-date && ng serve -c=localhost-serve -o",
    "docker": "npm run get-build-date && ng build   -c=docker && npx gzipper compress --verbose ./dist/circabc",
    "build-next": "npm run get-build-date && ng build -c=next ",
    "next": "npm run get-build-date && ng serve -c=next -o",
    "fabi": "npm run get-build-date && ng serve -c=fabi --host 0.0.0.0 --poll 2000",
    "next-docker": "npm run get-build-date && ng serve -c=next-docker --host 0.0.0.0 --poll 2000",
    "next-aws": "npm run get-build-date && ng serve -c=next-aws --host 0.0.0.0 --poll 2000",
    "ec2": "npm run get-build-date && ng serve -c=ec2 -o",
    "build-serve-aws": "npm run get-build-date && ng build -c=next && node server.js",
    "build-serve-aws-k8s": "npm run get-build-date && ng build -c=next && ALFRESCO_PORT=80 node server.js",
    "build-serve-aws-test": "npm run get-build-date && ng build -c=next && ALFRESCO_HOST=localhost node server.js",
    "build-serve-localhost": "npm run get-build-date && ng build -c=next && ALFRESCO_HOST=localhost node server.js",
    "serve-aws": "node server.js",
    "watch": "ng build --watch --configuration development",
    "test:file": "ng test --no-watch --include",
    "test": "ng test",
    "test:nw": "ng test --no-watch",
    "test:summary": "ng test --no-watch 2>&1 | sed 's/\\x1b\\[[0-9;]*m//g' | grep -E 'FAIL|passed|failed|Test Files|Errors'",
    "test:coverage": "ng test --coverage",
    "test:coverage:nw": "ng test --coverage --no-watch",
    "test:watch": "ng test --watch",
    "test:report": "ng test --no-watch --reporters=json --output-file=test-results.json",
    "test:verbose": "ng test --no-watch --reporters=verbose",
    "ncu": "npx npm-check-updates",
    "ncu-u-i": "npx npm-check-updates -u -i",
    "browserslist": "npx browserslist",
    "check": "npx npm-check -u",
    "link-status": "npx link-status -p",
    "gen-version": "npx openapi-generator-cli version",
    "gen-version-list": "npx openapi-generator-cli version-manager list",
    "gen-templates": "npx rimraf ./openapi-templates && npx openapi-generator-cli author template -g typescript-angular -o ./openapi-templates",
    "circabc-api": "npx rimraf src/app/core/generated/circabc && npx openapi-generator-cli generate -i apis/openapi.yaml -g typescript-angular -o src/app/core/generated/circabc --additional-properties ngVersion=22.1.1,providedInRoot=true,useSingleRequestParameter=true --template-dir ./openapi-templates && npx rimraf src/app/core/generated/circabc/api.module.ts && npm run format-fix-gen",
    "ares-bridge-api": "npx rimraf src/app/core/generated/ares-bridge && npx openapi-generator-cli generate -i apis/ares-bridge.yaml -g typescript-angular -o src/app/core/generated/ares-bridge --additional-properties ngVersion=9.0.0,providedInRoot=true && npm run format-fix-gen",
    "eu-captcha-api": "npx rimraf src/app/core/generated/eu-captcha && npx openapi-generator-cli generate -i apis/eu-captcha.yaml -g typescript-angular -o src/app/core/generated/eu-captcha --additional-properties ngVersion=9.0.0,providedInRoot=true && npm run format-fix-gen",
    "source-map": "ng build  --source-map",
    "source-map-explorer": "npx source-map-explorer dist/circabc/**/*.js",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find",
    "i18n:translate": "npx auto-translate-json-library src/assets/i18n/en.json -e aws -m file",
    "spellcheck": "npx cspell /src/**/*.ts"
  },
  "private": true,
  "dependencies": {
    "@alfresco/js-api": "10.0.0",
    "@angular/cdk": "22.1.2",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/material": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/router": "22.1.2",
    "@angular/service-worker": "22.1.2",
    "@jsverse/transloco": "8.4.0",
    "@microsoft/mgt": "4.6.1",
    "compression": "1.8.1",
    "express": "5.2.1",
    "file-saver": "2.0.5",
    "font-awesome": "4.7.0",
    "geist": "1.7.2",
    "http-proxy-middleware": "4.2.0",
    "ngx-cookie-service": "22.0.0",
    "ngx-extended-pdf-viewer": "29.0.1",
    "quill": "2.0.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@biomejs/biome": "2.5.8",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-keys-manager": "8.1.1",
    "@openapitools/openapi-generator-cli": "2.40.1",
    "@topce/native-preview": "7.0.5",
    "@types/file-saver": "2.0.7",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript/native-preview": "latest",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "jsdom": "29.1.1",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.10",
    "zx": "8.8.5"
  },
  "overrides": {
    "path-to-regexp": "8.4.0",
    "follow-redirects": "1.16.0",
    "next": "16.3.3",
    "js-yaml": "4.3.2",
    "qs": "6.16.0"
  }
}
