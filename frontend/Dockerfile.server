# Multi-stage build that compiles the Angular application and serves it with the custom Express server

FROM node:22.12 AS build

WORKDIR /usr/src/app

COPY package*.json ./
COPY angular.json ./
COPY tsconfig*.json ./
COPY ngsw-config.json ./
COPY getBuildDate.js ./
COPY src ./src

RUN npm install --legacy-peer-deps
RUN npm run  build-next


FROM node:22.12-slim AS runtime

WORKDIR /usr/src/app

ENV NODE_ENV=production \
    PORT=4200 \
    ALFRESCO_PORT=80

RUN npm install \
    express@5.1.0 \
    compression@1.8.1 \
    http-proxy-middleware@3.0.5

COPY server.js ./
COPY --from=build /usr/src/app/dist ./dist

EXPOSE 4200

CMD ["node", "server.js"]
