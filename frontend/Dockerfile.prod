FROM bitnamilegacy/nginx:1.29
USER 0

# Clean default content and unnecessary files
RUN rm -rf /opt/bitnami/nginx/html/* && \
    rm -rf /tmp/* /var/tmp/* && \
    find /opt/bitnami/nginx -type f -name "*.md" -delete 2>/dev/null || true

# Copy only production assets from the actual build output location
COPY dist/circabc/ /opt/bitnami/nginx/html/ui/
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && \
    chown -R 1001:1001 /opt/bitnami/nginx/html

EXPOSE 80
USER 1001
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/opt/bitnami/nginx/sbin/nginx", "-g", "daemon off;"]

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/circabc-caas/ui/ >/dev/null 2>&1 || exit 1
